# Ollama server. A local install listens here.
OLLAMA_HOST=http://127.0.0.1:11434

# Any tool-capable model you have pulled. Smaller models answer faster.
# qwen2.5:3b is a reasonable alternative once you have pulled it.
OLLAMA_MODEL=llama3.2:3b

# Folder the file and task tools are allowed to touch.
AGENT_WORKSPACE=workspace

# Maximum model round-trips per user message, including tool calls.
AGENT_MAX_STEPS=6

# Seconds to wait for one Ollama response.
OLLAMA_TIMEOUT=120
